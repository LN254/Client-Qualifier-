      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 380],
      "webhookId": "whatsapp-lead-webhook"
    },
    {
      "parameters": {
        "jsCode": "const source = $input.first().json;\n\n// Detect source\nconst isWhatsApp = source.waId !== undefined || source.WaId !== undefined;\n\nconst name = isWhatsApp\n  ? (source.ProfileName || source.contact?.name || 'Unknown')\n  : (source.name || source.Name || 'Unknown');\n\nconst email = isWhatsApp ? '' : (source.email || source.Email || '');\n\nconst phone = isWhatsApp\n  ? (source.waId || source.WaId || source.From || '')\n  : (source.phone || source.Phone || source.phoneNumber || '');\n\nconst message = isWhatsApp\n  ? (source.Body || source.text || source.message || '')\n  : (source.message || source.Message || source.inquiry || '');\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    name: name.trim(),\n    email: email.trim(),\n    phone: phone.toString().trim(),\n    source: isWhatsApp ? 'WhatsApp' : 'Website Form',\n    message: message.trim(),\n    status: 'New Lead',\n    followUpSent: 'No'\n  }\n}];"
      },
      "id": "node-normalize",
      "name": "Normalize Lead Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 290]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID_HERE",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $json.timestamp }}",
            "Name": "={{ $json.name }}",
            "Email": "={{ $json.email }}",
            "Phone": "={{ $json.phone }}",
            "Source": "={{ $json.source }}",
            "Message": "={{ $json.message }}",
            "Status": "={{ $json.status }}",
            "Follow-Up Sent": "={{ $json.followUpSent }}"
          }
        },
        "options": {}
      },
      "id": "node-sheets-append",
      "name": "Save Lead to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [740, 290]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://YOUR_WATI_ENDPOINT/api/v1/sendSessionMessage/{{ $json.phone }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_WATI_API_TOKEN"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "messageText",
              "value": "=Hey {{ $json.name }} 👋\n\nThanks for reaching out! We've received your message and our team will get back to you very shortly.\n\nWe're excited to help you out! 😊\n\n— [YOUR BUSINESS NAME]"
            }
          ]
        },
        "options": {}
      },
