//@version=5
indicator("Supply & Demand Zones (Sam Seiden Method)", shorttitle="S&D Zones (Seiden)", overlay=true, max_boxes_count=500, max_labels_count=500)

// =============================================================================
// SUPPLY & DEMAND ZONES — based on the methodology described in Sam Seiden's
// "Supply Demand Trading" (Online Trading Academy).
//
// Core idea: markets move in three phases — a LEG-IN, a BASE (consolidation
// where large orders are placed), and a LEG-OUT (the impulsive move that
// leaves the base). The base is where supply or demand becomes "imbalanced".
//
//   Leg-in UP  + Leg-out UP    = Rally-Base-Rally (RBR)  -> Demand (support)
//   Leg-in DOWN+ Leg-out UP    = Drop-Base-Rally  (DBR)  -> Demand (support)
//   Leg-in UP  + Leg-out DOWN  = Rally-Base-Drop  (RBD)  -> Supply (resistance)
//   Leg-in DOWN+ Leg-out DOWN  = Drop-Base-Drop   (DBD)  -> Supply (resistance)
//
// A zone is considered "fresh" (highest probability) until price returns and
// trades back into it — at that point it is "tested" and loses much of its
// edge, per Seiden's rules of profitable and non-profitable zones.
// =============================================================================

// ------------------------------- Inputs -------------------------------------
grpBase = "Base Detection"
baseAtrLen      = input.int(14, "ATR Length", minval=1, group=grpBase)
baseRangeFactor = input.float(0.5, "Basing Candle Max Range (x ATR)", minval=0.05, step=0.05, group=grpBase, tooltip="A candle is considered part of a base if its high-low range is <= this multiple of ATR.")
baseMaxBars     = input.int(6, "Max Candles in a Base", minval=1, maxval=20, group=grpBase, tooltip="Seiden favors tight, fast bases (typically 1-6 candles).")

grpBreak = "Leg-Out (Breakout) Detection"
legAtrFactor    = input.float(1.0, "Min Leg-Out Range (x ATR)", minval=0.1, step=0.1, group=grpBreak, tooltip="The candle leaving the base must have a range at least this multiple of ATR to count as a strong, imbalanced move.")

grpZones = "Zone Display"
showDemand      = input.bool(true, "Show Demand Zones", group=grpZones)
showSupply      = input.bool(true, "Show Supply Zones", group=grpZones)
useBodyProximal = input.bool(true, "Use Candle Body for Proximal Line", group=grpZones, tooltip="Proximal (near) line uses the base candles' open/close extreme; distal (far) line uses the wick extreme. This is the classic Seiden zone shape used for stop placement.")
zoneExtendBars  = input.int(300, "Extend Fresh Zones Right (bars)", minval=10, group=grpZones)
maxZonesEach    = input.int(6, "Max Fresh Zones to Keep (each side)", minval=1, maxval=30, group=grpZones)
hideTested      = input.bool(true, "Hide Zones Once Tested", group=grpZones)
showLabels      = input.bool(true, "Show Zone Labels", group=grpZones)
maxZoneAgeBars  = input.int(500, "Max Zone Age (bars, 0 = no limit)", minval=0, group=grpZones, tooltip="A zone stops counting as 'fresh' once it's older than this many bars, even if price never tested it. Prevents decades-old untested zones (e.g. historic crash levels) from cluttering the chart and table. ~500 on a daily chart is roughly 2 years.")

grpInfo = "Distance / Proximity Alerts"
showDistanceTable  = input.bool(true, "Show Nearest Zone Distance Table", group=grpInfo)
tablePosition      = input.string("top_right", "Table Position", options=["top_right", "top_left", "bottom_right", "bottom_left"], group=grpInfo)
pipSize            = input.float(0.0001, "Pip Size", minval=0.00000001, step=0.0001, group=grpInfo, tooltip="0.0001 for most FX pairs, 0.01 for JPY pairs, 1 for indices/stocks (then reads as points).")
maxRelevantPips    = input.float(150, "Max Relevant Distance (pips, 0 = no limit)", minval=0, group=grpInfo, tooltip="Hides a zone from the table/lines/alerts if it's farther than this many pips away, without deleting it from the chart. Keeps the table focused on levels price could realistically reach soon.")
enableProximityAlert = input.bool(true, "Enable 'Approaching Fresh Zone' Alert", group=grpInfo)
proximityPips         = input.float(20, "Proximity Alert Distance (pips)", minval=1, group=grpInfo, tooltip="Fires once when price closes within this many pips of the nearest fresh zone's proximal line, approaching from outside that distance.")
showNearestZoneLines  = input.bool(true, "Draw Lines at Nearest Fresh Zone Levels", group=grpInfo, tooltip="Draws a dashed ray at the nearest fresh demand/supply price shown in the table, even if the zone's box itself is off-screen.")

grpColors = "Colors"
demandColor      = input.color(color.new(color.teal, 75), "Demand (Fresh)", group=grpColors)
demandBorder     = input.color(color.new(color.teal, 20), "Demand Border", group=grpColors)
supplyColor      = input.color(color.new(color.red, 75), "Supply (Fresh)", group=grpColors)
supplyBorder     = input.color(color.new(color.red, 20), "Supply Border", group=grpColors)
testedColor      = input.color(color.new(color.gray, 85), "Tested Zone Fill", group=grpColors)
testedBorder     = input.color(color.new(color.gray, 50), "Tested Zone Border", group=grpColors)

// ------------------------------ Core Series ----------------------------------
atrVal = ta.atr(baseAtrLen)
rng    = high - low
isBasingCandle = rng <= baseRangeFactor * atrVal

// Count consecutive basing candles ending at bar[1] (i.e. immediately before
// the current, possibly-breakout, candle).
var int baseCount = 0
baseCount := 0
for i = 1 to baseMaxBars
    if isBasingCandle[i]
        baseCount += 1
    else
        break

isStrongLegOut = rng >= legAtrFactor * atrVal and not isBasingCandle
legOutBullish  = close > open
legOutBearish  = close < open

haveBase = baseCount >= 1 and baseCount < bar_index

// Leg-in candle sits immediately before the base (offset baseCount+1).
legInIdx = baseCount + 1
legInBullish = haveBase ? close[legInIdx] > open[legInIdx] : false
legInBearish = haveBase ? close[legInIdx] < open[legInIdx] : false

isDemandPattern = haveBase and isStrongLegOut and legOutBullish and (legInBullish or legInBearish)
isSupplyPattern = haveBase and isStrongLegOut and legOutBearish and (legInBullish or legInBearish)

// ------------------------------ Zone Storage ----------------------------------
var box[]   demandBoxes = array.new_box()
var box[]   supplyBoxes = array.new_box()
var label[] demandLabels = array.new_label()
var label[] supplyLabels = array.new_label()
var int[]   demandCreatedBar = array.new_int()
var int[]   supplyCreatedBar = array.new_int()

var bool enteredDemandZone = false
var bool enteredSupplyZone = false
enteredDemandZone := false
enteredSupplyZone := false

// ---------------------- Mitigation check (runs BEFORE new zones are added) ----
checkMitigation(boxArr, labelArr, createdArr) =>
    bool touched = false
    if array.size(boxArr) > 0
        for i = array.size(boxArr) - 1 to 0
            b = array.get(boxArr, i)
            top = box.get_top(b)
            bottom = box.get_bottom(b)
            bool overlap = low <= top and high >= bottom
            if overlap
                touched := true
                box.set_right(b, bar_index)
                box.set_bgcolor(b, testedColor)
                box.set_border_color(b, testedBorder)
                lbl = array.get(labelArr, i)
                if hideTested
                    box.delete(b)
                    if not na(lbl)
                        label.delete(lbl)
                    array.remove(boxArr, i)
                    array.remove(labelArr, i)
                    array.remove(createdArr, i)
                else
                    array.remove(boxArr, i)
                    array.remove(labelArr, i)
                    array.remove(createdArr, i)
    touched

enteredDemandZone := checkMitigation(demandBoxes, demandLabels, demandCreatedBar)
enteredSupplyZone := checkMitigation(supplyBoxes, supplyLabels, supplyCreatedBar)

// ------------------- Expiry check (drops zones older than Max Zone Age) -------
// A zone that's technically still untested but decades old (e.g. a historic
// crash level) is no longer practically relevant, so it's dropped from
// tracking entirely once it exceeds Max Zone Age, regardless of hideTested.
checkExpiry(boxArr, labelArr, createdArr) =>
    if maxZoneAgeBars > 0 and array.size(boxArr) > 0
        for i = array.size(boxArr) - 1 to 0
            createdBar = array.get(createdArr, i)
            if bar_index - createdBar > maxZoneAgeBars
                b = array.get(boxArr, i)
                lbl = array.get(labelArr, i)
                box.delete(b)
                if not na(lbl)
                    label.delete(lbl)
                array.remove(boxArr, i)
                array.remove(labelArr, i)
                array.remove(createdArr, i)

checkExpiry(demandBoxes, demandLabels, demandCreatedBar)
checkExpiry(supplyBoxes, supplyLabels, supplyCreatedBar)

// Extend still-active (fresh) zones further to the right each bar.
extendActive(boxArr) =>
    if array.size(boxArr) > 0
        for i = 0 to array.size(boxArr) - 1
            box.set_right(array.get(boxArr, i), bar_index + zoneExtendBars)
extendActive(demandBoxes)
extendActive(supplyBoxes)

// ------------------------------ Zone Creation ----------------------------------
baseLeftIdx = bar_index - baseCount

if isDemandPattern and showDemand
    baseHighestLow  = ta.highest(low, baseCount)[1]
    baseLowestLow   = ta.lowest(low, baseCount)[1]
    baseHighestBody = ta.highest(math.max(open, close), baseCount)[1]
    top    = useBodyProximal ? baseHighestBody : baseHighestLow
    bottom = baseLowestLow
    if top > bottom
        newBox = box.new(left=baseLeftIdx, top=top, right=bar_index + zoneExtendBars, bottom=bottom, border_color=demandBorder, bgcolor=demandColor, extend=extend.none)
        array.push(demandBoxes, newBox)
        array.push(demandCreatedBar, bar_index)
        if showLabels
            lbl = label.new(baseLeftIdx, bottom, "Demand\n(" + str.tostring(baseCount) + " candle base)", style=label.style_label_up, color=color.new(color.teal, 100), textcolor=color.teal, size=size.small)
            array.push(demandLabels, lbl)
        else
            array.push(demandLabels, na)
        if array.size(demandBoxes) > maxZonesEach
            oldBox = array.shift(demandBoxes)
            box.delete(oldBox)
            oldLbl = array.shift(demandLabels)
            if not na(oldLbl)
                label.delete(oldLbl)
            array.shift(demandCreatedBar)

if isSupplyPattern and showSupply
    baseHighestHigh = ta.highest(high, baseCount)[1]
    baseLowestHigh  = ta.lowest(high, baseCount)[1]
    baseLowestBody  = ta.lowest(math.min(open, close), baseCount)[1]
    top    = baseHighestHigh
    bottom = useBodyProximal ? baseLowestBody : baseLowestHigh
    if top > bottom
        newBox = box.new(left=baseLeftIdx, top=top, right=bar_index + zoneExtendBars, bottom=bottom, border_color=supplyBorder, bgcolor=supplyColor, extend=extend.none)
        array.push(supplyBoxes, newBox)
        array.push(supplyCreatedBar, bar_index)
        if showLabels
            lbl = label.new(baseLeftIdx, top, "Supply\n(" + str.tostring(baseCount) + " candle base)", style=label.style_label_down, color=color.new(color.red, 100), textcolor=color.red, size=size.small)
            array.push(supplyLabels, lbl)
        else
            array.push(supplyLabels, na)
        if array.size(supplyBoxes) > maxZonesEach
            oldBox = array.shift(supplyBoxes)
            box.delete(oldBox)
            oldLbl = array.shift(supplyLabels)
            if not na(oldLbl)
                label.delete(oldLbl)
            array.shift(supplyCreatedBar)

// ------------------------- Distance to Nearest Fresh Zone ---------------------
// Distance is measured to each zone's PROXIMAL line (the edge price reaches
// first) since that is the line that matters for entries/alerts. We also keep
// the actual line price so we can tell whether the zone sits above or below
// the current close (for the ▲/▼ arrow in the table).
nearestDemandDist = float(na)
nearestDemandLine = float(na)
if array.size(demandBoxes) > 0
    for i = 0 to array.size(demandBoxes) - 1
        lineVal = box.get_top(array.get(demandBoxes, i))
        d = math.abs(close - lineVal)
        if na(nearestDemandDist) or d < nearestDemandDist
            nearestDemandDist := d
            nearestDemandLine := lineVal

nearestSupplyDist = float(na)
nearestSupplyLine = float(na)
if array.size(supplyBoxes) > 0
    for i = 0 to array.size(supplyBoxes) - 1
        lineVal = box.get_bottom(array.get(supplyBoxes, i))
        d = math.abs(close - lineVal)
        if na(nearestSupplyDist) or d < nearestSupplyDist
            nearestSupplyDist := d
            nearestSupplyLine := lineVal

// Filter out zones that are technically nearest but too far away to be
// practically relevant (e.g. decades-old levels thousands of pips away).
// The zone stays on the chart — this only affects the table/lines/alerts.
if maxRelevantPips > 0 and not na(nearestDemandDist) and (nearestDemandDist / pipSize) > maxRelevantPips
    nearestDemandDist := na
    nearestDemandLine := na
if maxRelevantPips > 0 and not na(nearestSupplyDist) and (nearestSupplyDist / pipSize) > maxRelevantPips
    nearestSupplyDist := na
    nearestSupplyLine := na

var float prevDemandPips = na
var float prevSupplyPips = na
demandPips = na(nearestDemandDist) ? na : nearestDemandDist / pipSize
supplyPips = na(nearestSupplyDist) ? na : nearestSupplyDist / pipSize

approachingDemand = enableProximityAlert and not na(demandPips) and not na(prevDemandPips) and demandPips <= proximityPips and prevDemandPips > proximityPips
approachingSupply = enableProximityAlert and not na(supplyPips) and not na(prevSupplyPips) and supplyPips <= proximityPips and prevSupplyPips > proximityPips

prevDemandPips := demandPips
prevSupplyPips := supplyPips

// ------------------------------ Distance Table ---------------------------------
// Simple readout: the actual price level of the nearest fresh zone, plus an
// arrow showing which way price must move to reach it (▼ = zone is below
// price, ▲ = zone is above price) and a rounded pip count. "—" means no
// fresh zone of that type exists right now.
zonePriceText(line) =>
    na(line) ? "—" : str.tostring(line, format.mintick)

zonePipsText(dist, line) =>
    na(dist) ? "—" : (close > line ? "▼ " : "▲ ") + str.tostring(math.round(dist / pipSize)) + " pips"

tablePos = tablePosition == "top_right" ? position.top_right : tablePosition == "top_left" ? position.top_left : tablePosition == "bottom_right" ? position.bottom_right : position.bottom_left
var table infoTable = table.new(tablePos, 3, 3, border_width=1)
if showDistanceTable and barstate.islast
    table.cell(infoTable, 0, 0, "Fresh Zone", text_color=color.white, bgcolor=color.new(color.black, 40))
    table.cell(infoTable, 1, 0, "Price", text_color=color.white, bgcolor=color.new(color.black, 40))
    table.cell(infoTable, 2, 0, "Pips Away", text_color=color.white, bgcolor=color.new(color.black, 40))
    table.cell(infoTable, 0, 1, "Demand", text_color=color.white, bgcolor=color.new(color.teal, 60))
    table.cell(infoTable, 1, 1, zonePriceText(nearestDemandLine), text_color=color.white, bgcolor=color.new(color.teal, 60))
    table.cell(infoTable, 2, 1, zonePipsText(nearestDemandDist, nearestDemandLine), text_color=color.white, bgcolor=color.new(color.teal, 60))
    table.cell(infoTable, 0, 2, "Supply", text_color=color.white, bgcolor=color.new(color.red, 60))
    table.cell(infoTable, 1, 2, zonePriceText(nearestSupplyLine), text_color=color.white, bgcolor=color.new(color.red, 60))
    table.cell(infoTable, 2, 2, zonePipsText(nearestSupplyDist, nearestSupplyLine), text_color=color.white, bgcolor=color.new(color.red, 60))

// -------------------- Lines at Nearest Fresh Zone Levels -----------------------
// A dashed ray + price label at each nearest fresh zone's level, matching the
// table above. This keeps the level visible even when the zone's box itself
// is scrolled off the visible price range (as with far-away, still-fresh zones).
var line  nearestDemandLineObj  = na
var label nearestDemandLabelObj = na
var line  nearestSupplyLineObj  = na
var label nearestSupplyLabelObj = na

if showNearestZoneLines and barstate.islast
    if not na(nearestDemandLine)
        if na(nearestDemandLineObj)
            nearestDemandLineObj := line.new(bar_index - 1, nearestDemandLine, bar_index, nearestDemandLine, extend=extend.right, color=demandBorder, width=2, style=line.style_dashed)
            nearestDemandLabelObj := label.new(bar_index, nearestDemandLine, "Demand " + str.tostring(nearestDemandLine, format.mintick), style=label.style_label_left, color=color.new(color.teal, 0), textcolor=color.white, size=size.small)
        else
            line.set_xy1(nearestDemandLineObj, bar_index - 1, nearestDemandLine)
            line.set_xy2(nearestDemandLineObj, bar_index, nearestDemandLine)
            label.set_xy(nearestDemandLabelObj, bar_index, nearestDemandLine)
            label.set_text(nearestDemandLabelObj, "Demand " + str.tostring(nearestDemandLine, format.mintick))
    else
        if not na(nearestDemandLineObj)
            line.delete(nearestDemandLineObj)
            label.delete(nearestDemandLabelObj)
            nearestDemandLineObj := na
            nearestDemandLabelObj := na

    if not na(nearestSupplyLine)
        if na(nearestSupplyLineObj)
            nearestSupplyLineObj := line.new(bar_index - 1, nearestSupplyLine, bar_index, nearestSupplyLine, extend=extend.right, color=supplyBorder, width=2, style=line.style_dashed)
            nearestSupplyLabelObj := label.new(bar_index, nearestSupplyLine, "Supply " + str.tostring(nearestSupplyLine, format.mintick), style=label.style_label_left, color=color.new(color.red, 0), textcolor=color.white, size=size.small)
        else
            line.set_xy1(nearestSupplyLineObj, bar_index - 1, nearestSupplyLine)
            line.set_xy2(nearestSupplyLineObj, bar_index, nearestSupplyLine)
            label.set_xy(nearestSupplyLabelObj, bar_index, nearestSupplyLine)
            label.set_text(nearestSupplyLabelObj, "Supply " + str.tostring(nearestSupplyLine, format.mintick))
    else
        if not na(nearestSupplyLineObj)
            line.delete(nearestSupplyLineObj)
            label.delete(nearestSupplyLabelObj)
            nearestSupplyLineObj := na
            nearestSupplyLabelObj := na

// ------------------------------ Alerts ----------------------------------------
alertcondition(enteredDemandZone, title="Price Entered Demand Zone", message="Price has entered a fresh Demand (buy) zone on {{ticker}} at {{close}}.")
alertcondition(enteredSupplyZone, title="Price Entered Supply Zone", message="Price has entered a fresh Supply (sell) zone on {{ticker}} at {{close}}.")
alertcondition(approachingDemand, title="Price Approaching Demand Zone", message="Price is within the proximity threshold of a fresh Demand zone on {{ticker}} at {{close}}.")
alertcondition(approachingSupply, title="Price Approaching Supply Zone", message="Price is within the proximity threshold of a fresh Supply zone on {{ticker}} at {{close}}.")

if enteredDemandZone
    alert("Demand zone tested on " + syminfo.ticker + " at " + str.tostring(close), alert.freq_once_per_bar)
if enteredSupplyZone
    alert("Supply zone tested on " + syminfo.ticker + " at " + str.tostring(close), alert.freq_once_per_bar)
if approachingDemand
    alert("Price approaching fresh Demand zone on " + syminfo.ticker + " (" + str.tostring(demandPips, "#.#") + " pips away)", alert.freq_once_per_bar)
if approachingSupply
    alert("Price approaching fresh Supply zone on " + syminfo.ticker + " (" + str.tostring(supplyPips, "#.#") + " pips away)", alert.freq_once_per_bar)
